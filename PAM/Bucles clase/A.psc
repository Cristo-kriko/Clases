Algoritmo sin_titulo
	definir tamañoArchivo como real;
	definir archivosPesados, i, contadorPesados como entero;
	
	Para i=1 Hasta 8 Con Paso 1 Hacer
		escribir "escriba 8 archivos"
		leer tamañoArchivo
		
		Si expresion_logica Entonces
			acciones_por_verdadero
		SiNo
			acciones_por_falso
		Fin Si
	Fin Para
FinAlgoritmo
